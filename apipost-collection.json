      "id": "TST-S1",
      "name": "活动正常成交",
      "trace": {
        "AC": [
          "AC-02",
          "AC-03",
          "AC-06",
          "AC-14",
          "AC-18"
        ],
        "V": [
          "V-01",
          "V-02",
          "V-04",
          "V-06"
        ],
        "E": [
          "E-11"
        ]
      },
      "cases": [
        {
          "case_id": "S1-01",
          "api": "API-01",
          "name": "买家下单 2 件",
          "method": "POST",
          "path": "/api/v1/orders",
          "headers": {
            "X-Demo-Account": "buyer01",
            "Content-Type": "application/json"
          },
          "body": {
            "goods_id": 1,
            "quantity": 2
          },
          "preconditions": [
            "活动商品在售，单价 10000 分，可售 5 件"
          ],
          "assertions": [
            "HTTP 200",
            "data.status == '待支付'",
            "data.total_amount == 20000",
            "持久化 goods.available_stock == 3 且 occupied_stock == 2"
